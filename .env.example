# Em produção (Render), DATABASE_URL é injetado automaticamente via fromDatabase
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dubob?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dubob?schema=public"

# Gere um valor seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-forte"
# Sessão do cliente (só o perfil CLIENTE expira; a equipe fica logada até sair)
CLIENT_JWT_EXPIRES_IN="7d"
PORT=3000

# URL do frontend (usado no CORS)
CORS_ORIGIN="https://dubob.selfmachine.com.br,https://dubob.vercel.app,http://localhost:5173"
FRONTEND_URL="https://dubob.selfmachine.com.br"
BACKEND_URL="https://dubobbackend.onrender.com"

# Senhas sem padrão: preencha antes de rodar "npm run prisma:seed"
SEED_ADMIN_EMAIL="admin@dubob.com"
SEED_ADMIN_PASSWORD=""
SEED_FUNCIONARIO_EMAIL="funcionario@dubob.com"
SEED_FUNCIONARIO_PASSWORD=""
SEED_COZINHA_EMAIL="cozinha@dubob.com"
SEED_COZINHA_PASSWORD=""
SEED_CLIENTE_EMAIL="cliente@dubob.com"
SEED_CLIENTE_PASSWORD=""

# PIN para sair do modo totem e para deslogar a tela da mesa (validado no servidor)
TOTEM_EXIT_PIN=""
MESA_LOGOUT_PIN=""
